# Copy to .env at the repo root and fill in. NEVER commit .env (it is gitignored).
# Values can carry an inline comment after " #"; quote a value if it contains " #".

# ---- run mode
LLM_MODE=stub                  # stub (0 tokens, fixtures) | live

# ---- Nebius accounts (https://tokenfactory.nebius.com). Only NEBIUS_API_KEY is required for live runs.
NEBIUS_API_KEY=                # account A: default for every agent
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_API_KEY_A4_A5=          # optional: account for A4 + A5 (their LLM calls, tools, embeddings, A7 checks)
# NEBIUS_API_KEY_<AGENT>=      # optional: one agent label on its own account, e.g. NEBIUS_API_KEY_A3_PROFILE
EMBED_API_KEY=                 # optional: account for evidence-store / database query embeddings (default: NEBIUS_API_KEY)
# EMBED_BASE_URL=              # default: NEBIUS_BASE_URL
# EMBED_MODEL=                 # leave unset (store default Qwen/Qwen3-Embedding-8B); must match the ingest model

# ---- optional per-agent model overrides (exact IDs from the Nebius console)
# NEBIUS_MODEL_A1_DISEASE=
# NEBIUS_MODEL_A2_MECHANISM=
# NEBIUS_MODEL_A3_PROFILE=
# NEBIUS_MODEL_A6_REDTEAM=
# list prices, USD per 1M tokens, for the workbook Meta sheet:
# PRICE_<MODEL_ID_UPPER_UNDERSCORED>_IN=
# PRICE_<MODEL_ID_UPPER_UNDERSCORED>_OUT=

# ---- optional: local OpenAI-compatible server instead of Nebius (keys above are then ignored)
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_API_KEY=local

# ---- evidence store (search source = evstore). Docker: cd evidence-store && docker compose up -d
# DATABASE_URL=postgresql://frontier:frontier@localhost:5433/frontier

# ---- optional: web search (search source = web / both, A1/A4/A5 web tool). Key from https://app.tavily.com
TAVILY_API_KEY=
# TAVILY_DOMAINS=pubmed.ncbi.nlm.nih.gov,clinicaltrials.gov,fda.gov
# TAVILY_DEPTH=basic

# ---- optional: external database backend (search source = database / database+web)
DB_BACKEND=sample              # sample (built-in rows) | live
# POSTGRES_URL=postgresql://user:pass@localhost:5432/copd     (use a READ-ONLY database user)
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
# DB_MAPPING=                  # path to a different db_mapping.yaml

# ---- ports / launcher (defaults shown)
# LANGFLOW_PORT=7870           # frontier-ui starts Langflow here; UI: python3 frontier-ui/server.py --port 7881
# FRONTIER_ENGINE=             # path to workflow/ if frontier-ui lives outside the repo
# AUCTOR_MONITOR_PORT=7872     # live node monitor (Langflow runs)
