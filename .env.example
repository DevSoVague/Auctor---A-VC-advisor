# After `make restore-evidence` (Person 3's evidence store), use the frontier_evidence database instead:
#   DATABASE_URL=postgresql://frontier:frontier@localhost:5433/frontier_evidence
DATABASE_URL=postgresql://frontier:frontier@localhost:5433/frontier
PROFILE=dev                     # dev | final
LLM_MODE=live                   # live | stub
NEBIUS_API_KEY=
NEBIUS_BASE_URL=                # from the Nebius console
OPENAI_API_KEY=                 # fallback
GEMINI_API_KEY=                 # fallback
MAX_USD_PER_RUN=5
MAX_CALLS_PER_RUN=300
NCBI_API_KEY=
SEC_USER_AGENT="Team name contact@example.com"

# Run API for the Base44 app (scripts/serve_public.sh). Required whenever the API is public.
APP_API_TOKEN=
FRONTEND_ORIGINS=*            # comma-separated sites allowed to call the API from a browser
