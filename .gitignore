# Environment (rebuilt from uv.lock with `uv sync`)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Secrets: real values live only in .env
.env

# Private background material (sponsor brief with contact details), kept local only
Background_Info/
# Adam's local plan of attack (restart fallback), kept local only
plan/

# Raw data: downloaded by the ingest scripts, never committed
data/*
!data/.gitkeep

# Run outputs
outputs/
*.docx
*.xlsx
!tests/fixtures/**
mlruns/
mlflow.db

# Tool caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/
